{
  "extends": [
    "@wordpress/stylelint-config/scss"
  ],
  "rules": {
    "selector-class-pattern": [
      "^(?:[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:__[a-z0-9]+(?:-[a-z0-9]+)*)?(?:--[a-z0-9]+(?:-[a-z0-9]+)*)?|wp-.+|editor-.+|is-.+|has-.+|current-.+|menu-item-.+)$",
      {
        "resolveNestedSelectors": true,
        "message": "Use block__element--modifier for custom classes; preserve WordPress-owned classes."
      }
    ]
  }
}
