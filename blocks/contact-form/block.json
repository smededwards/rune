{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "rune/contact-form",
  "version": "0.3.0",
  "title": "Contact Form",
  "category": "widgets",
  "icon": "email-alt",
  "description": "A simple contact form with editable labels and PHP validation.",
  "textdomain": "rune",
  "attributes": {
    "nameLabel": {
      "type": "string",
      "default": "Your Name"
    },
    "emailLabel": {
      "type": "string",
      "default": "Email Address"
    },
    "subjectLabel": {
      "type": "string",
      "default": "Subject"
    },
    "messageLabel": {
      "type": "string",
      "default": "Message"
    },
    "namePlaceholder": {
      "type": "string",
      "default": "Enter your name"
    },
    "emailPlaceholder": {
      "type": "string",
      "default": "name@example.com"
    },
    "subjectPlaceholder": {
      "type": "string",
      "default": "Select a Subject (Optional)"
    },
    "messagePlaceholder": {
      "type": "string",
      "default": "How can I help?"
    },
    "buttonLabel": {
      "type": "string",
      "default": "Send Message"
    },
    "successMessage": {
      "type": "string",
      "default": "Thank you. Your message has been sent."
    }
  },
  "supports": {
    "html": false,
    "multiple": false
  },
  "editorScript": "file:../../build/contact-form.js"
}
